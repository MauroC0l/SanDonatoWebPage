{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/smista?percorso=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/calendari",
      "schedule": "0 23 * * *"
    }
  ],
  "functions": {
    "api/smista.js": {
      "maxDuration": 60
    }
  }
}
