# Copia questo file in .env e adatta i valori. .env è ignorato da git.

# ---------- Database ----------
# Postgres in locale, avviato con: docker compose up -d
DATABASE_URL=postgresql://psd:psd@localhost:5432/psd

# Quando sceglieremo l'hosting, qui andrà la stringa del servizio scelto,
# di solito con ?sslmode=require in fondo. Il codice non cambia.

# ---------- Archivio dei file (Cloudflare R2) ----------
# Senza queste variabili il sito funziona, ma il caricamento di nuove
# immagini risponde 503 con un messaggio esplicito. Le copertine già
# importate da WordPress continuano a vedersi: puntano ancora a WordPress.
#
# Da creare su Cloudflare (giurisdizione UE): DUE bucket e un token API con
# "Object Read & Write" su tutti e due. Istruzioni passo per passo in
# MESSA-ONLINE.md, sezione "L'archivio dei file". Per controllare che sia
# tutto a posto: node --env-file=.env scripts/prova-r2.mjs
R2_ACCOUNT_ID=
# Il bucket PUBBLICO: immagini, video, documenti
R2_BUCKET=
# Il bucket RISERVATO, senza accesso pubblico: i certificati medici. Senza
# questa variabile i certificati non si caricano (non finiscono mai in
# quello pubblico per ripiego).
R2_BUCKET_PRIVATO=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Dominio da cui si leggono i file del bucket pubblico: quello r2.dev che
# Cloudflare dà accendendo l'accesso pubblico, oppure un sottodominio
# proprio. Il bucket riservato non ne ha.
URL_PUBBLICO_FILE=

# Solo in locale: scrive i file in public/caricamenti invece che su R2.
# Su Vercel il disco è di sola lettura, quindi in produzione va lasciato via.
ARCHIVIO_LOCALE=1


# ---------- Dimostrazione ----------
# Da mettere SOLO sul progetto della demo, mai sul sito vero: accende la
# targhetta "versione di prova, dati inventati" e il noindex per i motori
# di ricerca. Spento (assente) per difetto.
VITE_SITO_DIMOSTRATIVO=

# Indirizzo dell'installazione WordPress da cui si leggevano le notizie.
# Oggi non lo usa più nessuna schermata: resta perché le immagini importate
# puntano ancora lì.
# VITE_WP_API_BASE=

# ---------- Calendari ufficiali ----------
# Il segreto con cui Vercel chiama la lettura notturna (/api/cron/calendari).
# Vercel lo manda da solo se la variabile si chiama esattamente così. Senza,
# la lettura notturna è SPENTA: i calendari si aggiornano solo con il
# pulsante "Aggiorna ora" del pannello, che lo dice in pagina.
# Una stringa lunga e casuale, per esempio: openssl rand -hex 32
CRON_SECRET=

# Facoltativa. Senza, le cartelle pubbliche di Drive si leggono dalla pagina
# che Google usa per mostrarle dentro ai siti: funziona subito, ma non è
# un'API e un giorno potrebbe cambiare. Con una chiave di Google Cloud
# (API "Google Drive" attiva, nessun altro permesso) si usa l'API ufficiale.
GOOGLE_DRIVE_API_KEY=
